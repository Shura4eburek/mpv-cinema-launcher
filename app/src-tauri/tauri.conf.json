{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPV Cinema",
  "version": "0.3.0",
  "identifier": "dev.shura4eburek.mpvcinema",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MPV Cinema",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/mpv-cinema-launcher/posters/*",
          "$DATA/mpv-cinema-launcher/posters/*",
          "$LOCALDATA/mpv-cinema-launcher/avatar.jpg",
          "$DATA/mpv-cinema-launcher/avatar.jpg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
